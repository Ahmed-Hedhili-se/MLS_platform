# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ------------------------------------------------------------
# Required
# ------------------------------------------------------------

# Signs the session cookie. Generate a fresh one per deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out.
FLASK_SECRET_KEY=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# The callback URL registered there must match where the app is
# served, e.g. https://your-host/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

# Only sqlite:// URLs are supported. A relative path is resolved
# against the project root, not the working directory.
DATABASE_URL=sqlite:///webapp/app.db

# SQLite journal mode. WAL is right on a normal disk and is the
# default. It does NOT work on a network filesystem -- the shared
# hosts that put home directories on one report "disk I/O error" on
# the first query. Set DELETE there.
# MLS_SQLITE_JOURNAL_MODE=DELETE

# Where frozen student snapshots are written. Relative to the
# project root when not absolute.
SUBMISSION_STORAGE_ROOT=data/submissions

# ------------------------------------------------------------
# Grading
# ------------------------------------------------------------

# Where grading runs.
#
#   auto    The server grades. Needs Docker and a host you control.
#           Students get their result minutes after submitting.
#
#   manual  The server only collects submissions and records the
#           commit SHA. You export the pending ones, grade them with
#           grade_offline.py on a machine that has Docker, and upload
#           the results. No Docker or snapshot storage needed here,
#           so the app can live on a small host -- at the cost of
#           students waiting for your grading run.
#
# Anything other than "manual" is treated as auto.
MLS_GRADING_MODE=auto

# Everything below this line applies to auto mode only.

# Image built from Dockerfile.grader:
#   docker build -f Dockerfile.grader -t mls-grader:1.0 .
GRADER_IMAGE=mls-grader:1.0

# Concurrent grading containers.
GRADING_WORKERS=2

# Resource cap per grading container. Defaults suit the current labs
# (sklearn on tens of thousands of rows) and are sized so the platform
# runs on a small server. Budget roughly:
#     RAM needed = GRADING_WORKERS x GRADER_MEMORY + 1 GB for the OS
# Raise them only if a lab trains something genuinely heavy.
GRADER_MEMORY=1g
GRADER_CPUS=1

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

MLS_HOST=0.0.0.0
MLS_PORT=5000
MLS_THREADS=8

# Set to https when behind a TLS-terminating proxy or ngrok, so
# generated URLs and the secure cookie flag are right.
MLS_URL_SCHEME=http

# Set to 1 ONLY for plain-HTTP local development. It drops the
# Secure flag from the session cookie; never set it in production.
# MLS_INSECURE_COOKIES=1

# Set to 1 to use the Werkzeug dev server. Never for real users.
# MLS_DEV_SERVER=1

# ------------------------------------------------------------
# Email (optional; leave blank to disable grade notifications)
# ------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------
# Cloning private student repositories (optional)
# ------------------------------------------------------------

# Read-only token used when cloning student repos. Needed only if
# student repositories are private; public ones clone anonymously.
#
# Set it in the environment of whatever does the cloning:
#   auto mode    -- on the server
#   manual mode  -- only on the machine running grade_offline.py,
#                   which is why manual mode keeps this credential
#                   off a public host entirely.
# GH_TOKEN=

# ------------------------------------------------------------
# GitHub archive (optional)
# ------------------------------------------------------------

# MLS_GITHUB_ORG=
# MLS_GITHUB_TOKEN=
